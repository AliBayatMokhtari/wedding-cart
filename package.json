{
  "name": "wedding-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "deploy": "pnpm build && gh-pages -d dist",
    "publish": "pnpm build && gh-pages -d dist -b gh-pages -m \"chore: publish site to GitHub Pages\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,vue,json,css,scss,md,html}\" \"*.{ts,js,json,md,html}\" \"public/**/*.css\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,vue,json,css,scss,md,html}\" \"*.{ts,js,json,md,html}\" \"public/**/*.css\""
  },
  "dependencies": {
    "@unocss/reset": "^66.7.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.38"
  },
  "devDependencies": {
    "@iconify-json/mdi": "^1.2.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.13.2",
    "@unocss/preset-attributify": "^66.7.2",
    "@unocss/preset-icons": "^66.7.2",
    "@unocss/preset-uno": "^66.7.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "gh-pages": "^6.3.0",
    "npm-run-all2": "^9.0.2",
    "prettier": "^3.8.4",
    "typescript": "~6.0.0",
    "unocss": "^66.7.2",
    "vite": "^8.0.16",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.3.5"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
